<%
// NB: Quarto passes this template's output through Pandoc as Markdown, so keep
// every line flush left. Indented lines after a blank line become a code block.
// Turns a status like "In flight" into a CSS-friendly class: "status-in-flight"
const slug = (s) => String(s || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-');
%>
<div class="sb" data-status-board>
<div class="sb-board">
<div class="sb-header">
<div class="sb-title">
<svg class="sb-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 20h20"></path><path d="M3.5 13.5l4.2 2.3 11.6-4.6c1-.4 1.5-1.5 1.1-2.4-.4-.9-1.4-1.3-2.3-.9l-3.9 1.6L8 5.6 6.2 6.3l3.6 4.9-3.6 1.4-2.4-1.4-1.3.5 1 1.8z"></path></svg>
<div>
<p class="sb-heading">Arrivals</p>
<p class="sb-subheading">Projects in progress</p>
</div>
</div>
<button class="sb-replay" type="button">Replay</button>
</div>
<table class="sb-table">
<caption class="visually-hidden">Current projects: status, theme and estimated arrival</caption>
<thead>
<tr>
<th scope="col" data-col="code">Flight</th>
<th scope="col" data-col="project">Project</th>
<th scope="col" data-col="theme">Theme</th>
<th scope="col" data-col="status">Status</th>
<th scope="col" data-col="eta">Est. arrival</th>
</tr>
</thead>
<tbody class="list">
<% for (const item of items) { %>
<tr class="sb-row status-<%= slug(item.status) %>" <%= metadataAttrs(item) %>>
<td class="sb-cell sb-code" data-col="code"><%= item.code %></td>
<td class="sb-cell sb-project" data-col="project"><%= item.project %></td>
<td class="sb-cell sb-theme" data-col="theme"><%= item.theme %></td>
<td class="sb-cell sb-status" data-col="status"><%= item.status %></td>
<td class="sb-cell sb-eta" data-col="eta"><%= item.eta %></td>
</tr>
<% } %>
</tbody>
</table>
<ul class="sb-legend" aria-label="Status key">
<li class="status-scheduled">Scheduled</li>
<li class="status-boarding">Boarding</li>
<li class="status-in-flight">In flight</li>
<li class="status-delayed">Delayed</li>
<li class="status-landed">Landed</li>
</ul>
</div>
</div>
